    {
      "name": "Webhooks",
      "description": "Эмуляция эквайера. Если задан `webhookSecret`, pre-request считает HMAC-SHA256 сырого тела и ставит `X-Signature`.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.collectionVariables.get('webhookSecret');",
              "if (!secret) { return; }",
              "const CryptoJS = require('crypto-js');",
              "const raw = pm.variables.replaceIn(pm.request.body.raw || '');",
              "const sig = CryptoJS.HmacSHA256(raw, secret).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({ key: 'X-Signature', value: sig });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Payment webhook (paid)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('eventId')) {",
                  "  pm.collectionVariables.set('eventId', 'evt-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"order_id\": \"{{orderId}}\",\n  \"status\": \"paid\",\n  \"amount\": {{amount}},\n  \"currency\": \"RUB\",\n  \"created_at\": \"2025-01-01T12:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/webhooks/payment",
            "description": "Поля: `event_id` (string, max 128), `order_id` (uuid), `amount_cents` (int ≥ 1), `status` только `paid`.\n\nПеред вызовом создайте заказ (Orders → Create order), чтобы заполнить `orderId` и `amountCents`."
          }
        },
        {
          "name": "Payment webhook — duplicate event_id",
          "event": [
