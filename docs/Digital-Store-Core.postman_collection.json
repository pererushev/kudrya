              "raw": "{\n  \"event_id\": \"evt-bad-{{$timestamp}}\",\n  \"order_id\": \"{{orderId}}\",\n  \"amount_cents\": 1,\n  \"status\": \"paid\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/webhooks/payment",
            "description": "Сумма не совпадает с заказом → 422, событие не пишется, статус остаётся `created`."
          },
          "response": [
            {
              "name": "422 amount mismatch",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"event_id\": \"evt-bad\",\n  \"order_id\": \"9f1c2a3b-4d5e-6789-abcd-ef0123456789\",\n  \"amount_cents\": 1,\n  \"status\": \"paid\"\n}"
                },
                "url": "{{baseUrl}}/api/webhooks/payment"
              },
              "status": "Unprocessable Entity",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Amount does not match the order.\",\n  \"errors\": {\n    \"amount_cents\": [\"Amount does not match the order.\"]\n  }\n}"
            }
          ]
        }
      ]
    },
